# ==========================================================================
# Hospital Operations Management System — .gitignore
# Never commit credentials, API keys, secrets, model files, or local env config.
# ==========================================================================

# ------------------------------- Python ----------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --------------------------- Virtual environments -------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.python-version

# ------------------------------ Flask -------------------------------------
instance/
.webassets-cache
flask_session/

# ---------------------- SQLite local artefacts ----------------------------
# Ignore local/dev databases; commit seed/migration scripts explicitly instead.
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# --------------------- Environment variables / secrets --------------------
.env
.env.*
!.env.example
*.local
secrets.*
*.pem
*.key

# ------------------------------ Docker ------------------------------------
# Local Docker development artefacts / overrides
docker-compose.override.yml
*.pid

# --------------------------- Ollama / model files -------------------------
# Never commit downloaded model weights.
models/
*.gguf
*.bin
*.safetensors
*.pt
*.onnx

# ------------------------------- Logs -------------------------------------
logs/
*.log
npm-debug.log*
pip-log.txt

# --------------------------- Test / coverage caches -----------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.cache/

# ------------------------------- VS Code ----------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ------------------------------- macOS ------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ------------------------------ Windows -----------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ------------------------------- Misc -------------------------------------
*.tmp
*.bak
*.swp

# --------------------- Scaffold directories (re-included) -----------------
# The Python pattern `build/` above is unanchored and would otherwise ignore
# the prescribed `scripts/build/` directory. Re-include it explicitly.
!scripts/build/
